rules_version = '2';

// movie-editer-viewer 用の Firestore ルール（Firebase コンソールの Firestore ▸ ルール に貼る）
// - 読めるのはメール/パスワードでログインした本人だけ。OWNER_EMAIL を自分のアカウントのメールアドレスに書き換える
// - Authentication の「ユーザーの作成（登録）」を無効にし、アカウントはコンソールで作る（同じメールアドレスは2つ作れない）
// - ブラウザからは書き込ませない（movie-editer の publish はサービスアカウントで送るのでルールに関係なく書ける）
service cloud.firestore {
  match /databases/{database}/documents {
    match /videos/{name} {
      allow read: if request.auth != null
        && request.auth.token.email == 'OWNER_EMAIL';
      allow write: if false;
    }
  }
}
